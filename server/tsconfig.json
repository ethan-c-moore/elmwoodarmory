{
  "compilerOptions": {
    "target": "es2016",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "typeRoots": ["./node_modules/@types", "./server/types"],
    "types": ["node", "express", "express-session"]
  },
  "include": ["./**/*.ts", "./types/*.d.ts"]
}
